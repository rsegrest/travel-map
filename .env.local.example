NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL for blog posts. Must be NEXT_PUBLIC_ since it's read from a client component.
NEXT_PUBLIC_BLOG_BASE_URL=http://localhost:3010

# Used only by the local JSON fallback. In development, the app also accepts demo-owner-key.
MAP_OWNER_KEY=

# Optional. Enables server-side dynamic city coordinate lookup for the editor.
GEOAPIFY_API_KEY=
